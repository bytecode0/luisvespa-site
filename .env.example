# Copy to .env.local for local overrides. On Vercel, set these per environment
# (Settings → Environment Variables). Never commit real .env files.

# Public URL of this environment (no trailing slash). Defaults to https://www.luisvespa.com
NEXT_PUBLIC_SITE_URL=https://pre.luisvespa.com

# "preproduction" = noindex everywhere + visible PRE-PRODUCTION badge. Leave empty in production.
NEXT_PUBLIC_SITE_ENV=preproduction
